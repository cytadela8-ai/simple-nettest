[Unit]
Description=Simple Nettest results dashboard
Wants=network-online.target
After=network-online.target nettest.service

[Service]
Type=exec
ExecStart=/usr/bin/python3 /opt/nettest/dashboard_server.py --bind 0.0.0.0 --port 8000 --logs /var/log/nettest
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
